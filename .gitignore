# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/test-results
/playwright-report
/playwright/.cache
/.screenshots
/.frames
/hatalar
/Hatalar*

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# AI skills (skills.sh) — yerel araçlar, uygulamanın parçası değil
/.agents/
/.claude/skills/
/.claude/settings.local.json
/skills-lock.json

# iOS build artifacts (Xcode derived data, pods)
ios/App/Pods/
ios/App/App.xcworkspace/xcuserdata/
ios/App/*.xcarchive
ios/DerivedData/

# typescript
*.tsbuildinfo
next-env.d.ts

# geçici önizleme/screenshot dosyaları
_preview.*
_shot.mjs
_shot2.mjs
_giris.mjs
_giris_cek.mjs

# paylaşım/pazarlama çalışması — yerel kalır (görseller ~30 MB)
/paylasim-gorselleri/
PAYLASIM_METINLERI.md

# App Store imzalama anahtarları/sertifikaları — SIR, asla commit edilmez
/app-store-assets/
*.p8
*.p12
*.mobileprovision
*.certSigningRequest

# Supabase CLI yerel durum/önbellek dosyaları
/supabase/.temp/
